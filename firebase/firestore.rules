rules_version = '2';

// عقلي الثاني: قواعد حماية المؤسسة على Firestore
// إصدار القواعد: 9 (عقل الفروع وتقييماتها)
// المرحلة ١: الحسابات (المدير، والموظفون، والدعوات)
//
// انسخ هذا الملف كاملاً في Firebase ← Firestore Database ← Rules، ثم اضغط Publish.
//
// المبادئ:
// • مؤسسة واحدة فقط في المشروع (المستند orgs/main)، وأول من يُنشئها هو المدير الوحيد.
// • لا يضيف موظفاً ولا يحذفه ولا يرى الدعوات إلا المدير؛ مفروض هنا لا في الواجهة فقط.
// • الموظف ينضم بدعوة صالحة تُستهلك في اللحظة نفسها؛ من يسجّل دون دعوة لا يرى شيئاً.
// • ملاحظات الموظف الشخصية لا تصل إلى هنا أبداً؛ تبقى على جواله.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function orgDoc() { return /databases/$(database)/documents/orgs/main; }
    function invite(code) { return /databases/$(database)/documents/invites/$(code); }
    function room(id) { return /databases/$(database)/documents/rooms/$(id); }
    function branch(uid) { return /databases/$(database)/documents/branches/$(uid); }
    // مسؤول له فرع يدير حساباته (ينشره له هاتف رئيس القسم): manage = كرات يستطيع إضافة حسابات فيها
    function canManage(node) { return isMember() && exists(branch(request.auth.uid)) && node in get(branch(request.auth.uid)).data.manage; }
    function inviteKeys(d) {
      return d.keys().hasOnly(['displayName', 'username', 'createdBy', 'createdAt', 'node', 'title', 'replaces'])
        && (!('node' in d) || (d.node is string && d.node.size() <= 40))
        && (!('title' in d) || d.title in ['head', 'assistant', 'member'])
        && (!('replaces' in d) || (d.replaces is string && d.replaces.size() <= 128));
    }
    function isMember() { return signedIn() && exists(me()); }
    function isManager() { return isMember() && get(me()).data.role == 'manager'; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validUsername(v) { return v is string && v.matches('^[a-z0-9._-]{3,30}$'); }

    // ---- المؤسسة ----
    match /orgs/{id} {
      // الاسم ظاهر لشاشة الدخول والدعوة؛ لا شيء سري هنا
      allow get: if true;
      allow list: if false;
      // تُنشأ مرة واحدة، ومعها عضوية المدير في الدفعة نفسها
      allow create: if signedIn() && id == 'main'
        && request.resource.data.keys().hasOnly(['name', 'owner', 'createdAt'])
        && text(request.resource.data.name, 80)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(me()).data.role == 'manager';
      // المدير يغيّر الاسم فقط، ولا ينقل الملكية
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && text(request.resource.data.name, 80);
      allow delete: if false;
    }

    // ---- الأعضاء ----
    match /members/{uid} {
      // الأعضاء يرون أسماء بعضهم، وكل حساب يقرأ عضويته هو (ولو لم يكن عضواً بعد)
      allow read: if isMember() || (signedIn() && uid == request.auth.uid);
      allow create: if signedIn() && uid == request.auth.uid && !exists(me())
        && text(request.resource.data.displayName, 60)
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && (
          // المدير: صاحب المؤسسة التي تُنشأ في الدفعة نفسها
          (request.resource.data.keys().hasOnly(['role', 'displayName', 'username', 'createdAt'])
            && request.resource.data.role == 'manager'
            && !exists(orgDoc())
            && getAfter(orgDoc()).data.owner == request.auth.uid)
          ||
          // الموظف: بدعوة صالحة باسمه، تُحذف في الدفعة نفسها (فلا تُستخدم مرتين)
          (request.resource.data.keys().hasOnly(['role', 'displayName', 'username', 'createdAt', 'invite', 'node', 'title', 'replaces'])
            && request.resource.data.role == 'employee'
            && (!('node' in request.resource.data) || request.resource.data.node == get(invite(request.resource.data.invite)).data.node)
            && (!('title' in request.resource.data) || request.resource.data.title == get(invite(request.resource.data.invite)).data.title)
            && (!('replaces' in request.resource.data) || request.resource.data.replaces == get(invite(request.resource.data.invite)).data.replaces)
            && request.resource.data.invite is string
            && exists(invite(request.resource.data.invite))
            && get(invite(request.resource.data.invite)).data.username == request.resource.data.username
            && get(invite(request.resource.data.invite)).data.displayName == request.resource.data.displayName
            && !existsAfter(invite(request.resource.data.invite)))
        );
      // لا تعديل للأدوار أبداً
      allow update: if false;
      // المدير يزيل موظفاً، ولا يزيل نفسه
      allow delete: if isManager() && uid != request.auth.uid;
    }

    // ---- الدعوات ----
    match /invites/{code} {
      // الرمز سري (١٠ أحرف عشوائية)؛ يكفي لعرض اسم المدعو قبل التسجيل
      allow get: if true;
      allow list: if isManager();
      // المدير، أو مسؤول يدير حسابات تلك الكرة من فرعه
      allow create: if code.size() >= 10 && inviteKeys(request.resource.data)
        && (isManager() || ('node' in request.resource.data && canManage(request.resource.data.node)))
        && text(request.resource.data.displayName, 60)
        && validUsername(request.resource.data.username)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // يلغيها المدير، أو يستهلكها المدعو نفسه وهو ينضم
      allow delete: if isManager()
        || (isMember() && resource.data.createdBy == request.auth.uid)
        || (signedIn() && !exists(me())
            && getAfter(me()).data.role == 'employee'
            && getAfter(me()).data.invite == code);
    }

    // ---- مجموعة المؤسسة: نقل فقط، لا تخزين ----
    // كل رسالة تحمل قائمة من لم يستلمها بعد (pending). كل جهاز يحذف نفسه منها عند الاستلام،
    // وآخر مستلم يحذف الرسالة من السحابة. الأرشيف الدائم على جوال المدير، وكل موظف يحتفظ بما وصله.
    match /relay/{id} {
      function validMsg(d) {
        return d.keys().hasOnly(['mid', 'from', 'fromName', 'text', 'image', 'tag', 'room', 'sentAt', 'createdAt', 'pending', 'history'])
          && (!('tag' in d) || text(d.tag, 60))
          && (!('room' in d) || (d.room is string && d.room.size() <= 64))
          && d.mid is string && d.mid.size() <= 64
          && d.from is string && text(d.fromName, 60)
          && (!('text' in d) || (d.text is string && d.text.size() <= 4000))
          && (!('image' in d) || (d.image is string && d.image.size() <= 900000))
          && ('text' in d || 'image' in d)
          && d.pending is list && d.pending.size() >= 1 && d.pending.size() <= 300
          && d.sentAt is int
          && d.createdAt == request.time;
      }
      // يقرؤها من لم يستلمها بعد، والمدير (لتنظيف رسائل من أُزيلوا)
      allow get, list: if isMember() && (request.auth.uid in resource.data.pending || isManager());
      // رسالة جديدة: باسم مرسلها الحقيقي، ولا يرسلها لنفسه
      allow create: if isMember() && validMsg(request.resource.data)
        && !('history' in request.resource.data)
        && request.resource.data.mid == id
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromName == get(me()).data.displayName
        && !(request.auth.uid in request.resource.data.pending)
        // مجموعة كرة: المرسل من أعضائها، ولا تصل إلا لأعضائها
        && (!('room' in request.resource.data) || request.resource.data.room == 'general'
            || (request.auth.uid in get(room(request.resource.data.room)).data.members
                && get(room(request.resource.data.room)).data.members.toSet().hasAll(request.resource.data.pending.toSet())));
      // أرشيف المجموعة القديم: يرسله المدير لموظف جديد (يحفظ اسم المرسل الأصلي)
      allow create: if isManager() && validMsg(request.resource.data)
        && request.resource.data.history == true
        && request.resource.data.pending.size() == 1;
      // الاستلام: المستلم يحذف نفسه من القائمة فقط؛ والمدير يحذف من القائمة من أُزيلوا
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending'])
        && (request.resource.data.pending.toSet() == resource.data.pending.toSet().difference([request.auth.uid].toSet())
            || (isManager() && resource.data.pending.toSet().hasAll(request.resource.data.pending.toSet())));
      // آخر مستلم يحذفها، والمدير ينظف
      allow delete: if isMember()
        && (resource.data.pending.toSet().difference([request.auth.uid].toSet()).size() == 0 || isManager());
    }

    // علامة: أرسل المدير أرشيف المجموعة لهذا الموظف
    match /handoffs/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isManager());
      allow list: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['count', 'at'])
        && request.resource.data.count is int && request.resource.data.at == request.time;
      allow delete: if isManager();
    }

    // المجموعات:
    // • مجموعات الكرات (n_…): كل كرة في عقل المؤسسة مجموعة، أعضاؤها ينشرهم المدير من هيكله.
    // • مجموعات المحادثة (c_…): ينشئها أي عضو. يضيف مباشرة من في وحدته وما تحتها (contacts التي ينشرها المدير له)،
    //   ومن هو أعلى منه تصله دعوة (invited) فينضم بنفسه أو يرفض. المدير يضيف أي أحد.
    match /rooms/{roomId} {
      function contactsOk(added) {
        return added.size() == 0 || isManager() || get(/databases/$(database)/documents/places/$(request.auth.uid)).data.contacts.toSet().hasAll(added);
      }
      function chatOk(d) {
        return roomId.matches('c_[a-z0-9]{6,20}')
          && d.keys().hasOnly(['name', 'color', 'members', 'invited', 'kind', 'owner', 'enrich', 'at'])
          && (!('enrich' in d) || d.enrich is bool)
          && d.kind == 'chat' && text(d.name, 60) && d.color is string && d.color.size() <= 9
          && d.owner == request.auth.uid && request.auth.uid in d.members
          && d.members is list && d.members.size() <= 256
          && d.invited is list && d.invited.size() <= 50
          && !d.members.toSet().hasAny(d.invited)
          && d.at == request.time;
      }
      // كرات المؤسسة يقرؤها المدير؛ ومجموعة المحادثة لأعضائها ومدعوّيها فقط (ولا يراها المدير إن لم يكن فيها)
      allow get, list: if isMember() && (
        request.auth.uid in resource.data.members
        || request.auth.uid in resource.data.get('invited', [])
        || (isManager() && resource.data.kind != 'chat'));

      allow create, update: if isManager() && roomId.matches('n_.*')
        && request.resource.data.keys().hasOnly(['name', 'color', 'members', 'kind', 'at'])
        && request.resource.data.kind != 'chat'
        && text(request.resource.data.name, 60)
        && request.resource.data.members is list && request.resource.data.members.size() <= 500
        && request.resource.data.at == request.time;
      allow delete: if isManager() && roomId.matches('n_.*');

      // مجموعة محادثة جديدة
      allow create: if isMember() && chatOk(request.resource.data)
        && contactsOk(request.resource.data.members.toSet().difference([request.auth.uid].toSet()));
      // صاحبها يعدّلها: من يضيفه مباشرة من جهاته، أو كان عضواً قبلاً
      allow update: if isMember() && resource.data.owner == request.auth.uid && chatOk(request.resource.data)
        && contactsOk(request.resource.data.members.toSet().difference(resource.data.members.toSet()));
      // المدعو ينضم (ينتقل من المدعوين إلى الأعضاء) أو يرفض، والعضو يغادر
      allow update: if isMember() && resource.data.kind == 'chat'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invited'])
        && request.resource.data.invited.toSet() == resource.data.invited.toSet().difference([request.auth.uid].toSet())
        && (
          (request.auth.uid in resource.data.invited
            && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
          || (request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && resource.data.owner != request.auth.uid)
        );
      allow delete: if isMember() && resource.data.kind == 'chat' && resource.data.owner == request.auth.uid;
    }

    // فرع كل مسؤول: كراته وأسماء من فيها وخيارات إظهاره؛ ينشره هاتف رئيس القسم، ويقرؤه صاحبه فقط
    match /branches/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isManager());
      allow list: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['heads', 'nodes', 'people', 'perms', 'manage', 'mind', 'evals', 'at'])
        && request.resource.data.manage is list && request.resource.data.manage.size() <= 500
        && request.resource.data.at == request.time;
      allow delete: if isManager();
    }
    // طلبات المسؤولين لتعديل فروعهم (إضافة كرة، تسمية، حذف حساب...): يطبّقها هاتف رئيس القسم بعد التحقق ثم يحذفها
    match /requests/{id} {
      allow create: if isMember() && !isManager()
        && request.resource.data.keys().hasOnly(['from', 'op', 'payload', 'at'])
        && request.resource.data.from == request.auth.uid
        && text(request.resource.data.op, 30)
        && request.resource.data.payload is map
        && request.resource.data.at == request.time;
      allow get, list, delete: if isManager();
    }

    // أماكن الموظف في عقل المؤسسة: أسماء كراته، ومن يستطيع إضافتهم مباشرة لمجموعة محادثة (من في وحدته وما تحتها)
    match /places/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isManager());
      allow list: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['places', 'contacts', 'at'])
        && request.resource.data.places is list && request.resource.data.places.size() <= 30
        && (!('contacts' in request.resource.data) || (request.resource.data.contacts is list && request.resource.data.contacts.size() <= 1000))
        && request.resource.data.at == request.time;
      allow delete: if isManager();
    }

    // كل ما عدا ذلك مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
